{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPL Studio",
  "version": "0.1.0",
  "identifier": "com.mpl.studio",
  "build": {
    "beforeDevCommand": "pnpm client --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5178",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MPL Studio — music, typed",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "center": true,
        "theme": "Light",
        "backgroundColor": "#f1eee5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MPL",
    "category": "DeveloperTool",
    "shortDescription": "Local-first editor for Music Production Language",
    "longDescription": "MPL Studio is a local-first editor for the MPL compiler, with live diagnostics, build-and-play audio, waveform inspection and compiler reports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bin/mplc.exe",
      "resources/stdlib",
      "resources/examples"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
